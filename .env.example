# 二选一：服务 API KEY 或腾讯云 TC3
# 不要把真实值提交到仓库；此文件仅作模板。
# 留空 = 未配置，auto 模式会落到 replay；填入真实 key 后才会走 live。
#
# 方式 A（推荐）：元宝搜索控制台 -> 概览 -> 服务 API KEY 方式 -> 创建 API KEY
#   https://console.cloud.tencent.com/wsapi/index
#   创建后只显示一次，形如 sk-xxxxxxxx；填到下面 WSA_API_KEY。
#   注意：AKI... 开头的是腾讯云 SecretId，不是服务 API KEY，不能填这里。
WSA_API_KEY=

# 方式 B（TC3）：腾讯云控制台 -> API 密钥管理 -> 新建密钥
#   https://console.cloud.tencent.com/cam/capi
#   SecretId 形如 AKI...；SecretKey 只在创建时显示一次。
#   使用 TC3 时把 WSA_API_KEY 留空，填下面两项。
WSA_SECRET_ID=
WSA_SECRET_KEY=

# auto: 有凭证走 live，否则 replay；也可强制 live / replay
WSA_MODE=auto

# 1 = 把 live 响应写入 runs/records.jsonl，供 replay 使用
WSA_RECORD=0

# 本地服务
WSA_HOST=127.0.0.1
WSA_PORT=8765
WSA_TIMEOUT=12
WSA_MAX_WORKERS=4

# 可选：接入 LLM 润色回答；不配置也能完整运行
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
